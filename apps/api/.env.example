# ─── Runtime ──────────────────────────────────────────────────────────────
# One of: dev | staging | prod. In production set NODE_ENV=prod (or the
# Node/Railway default 'production' — both are treated as production). Production
# turns on trust-proxy and makes the refresh cookie SameSite=None; Secure so it
# survives the cross-domain web↔API auth calls.
NODE_ENV=dev
# Port the API listens on. On Railway/PaaS this is injected — do NOT hardcode it;
# the app binds 0.0.0.0 on $PORT (falls back to 3000 locally).
PORT=3000
# Comma-separated origins allowed to call the API. In dev this is the Vite web
# app; in prod set it to the deployed web origin, e.g. https://your-web.up.railway.app
# (WEB_ORIGIN is accepted as an alias for this).
CORS_ORIGIN=http://localhost:5173

# ─── Database (MySQL 8, InnoDB + utf8mb4) ─────────────────────────────────
# Matches docker-compose.yml credentials in local dev.
# The database must be created with utf8mb4 / utf8mb4_unicode_ci.
DATABASE_URL="mysql://cpp:cpp_local_dev@localhost:3307/cost_provision"
# Shadow DB for `prisma migrate dev` (lets a restricted user migrate without
# global CREATE DATABASE rights). Create it with utf8mb4 too.
SHADOW_DATABASE_URL="mysql://cpp:cpp_local_dev@localhost:3307/cost_provision_shadow"

# ─── Auth / JWT ───────────────────────────────────────────────────────────
# Use long, random, distinct secrets per environment
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
# Short-lived access token; longer-lived rotating refresh token
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# bcrypt cost factor (must be >= 12)
BCRYPT_ROUNDS=12

# ─── Email (AWS SES via Nodemailer) ───────────────────────────────────────
# MAIL_ENABLED=false forces in-app-only notifications (no SES needed). Email is
# also auto-disabled whenever the SES vars below are blank, so the app boots
# cleanly with no AWS config — the demo relies on in-app notifications only.
MAIL_ENABLED=false
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=no-reply@example.com

# ─── Scheduler (daily IST cron) ───────────────────────────────────────────
# SCHEDULER_ENABLED=false disables the automated daily open/reminder cron. The
# admin "open now" endpoints still work, so the demo drives cycles manually.
SCHEDULER_ENABLED=false
